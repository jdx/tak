{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tak.jdx.dev/schema/tak.json",
  "title": "tak.toml",
  "description": "Benchmarks and settings for tak (https://tak.jdx.dev). Pre-v1: keys may change between releases.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bench": {
      "description": "Benchmarks by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/bench"
      }
    },
    "defaults": {
      "description": "Settings every benchmark starts from.",
      "$ref": "#/definitions/layer"
    },
    "subject": {
      "description": "Subjects declared once, for benchmarks to list in `subjects`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/subject"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "description": "Variables removed from measured commands. Replaces the default list (GITHUB_TOKEN, GH_TOKEN).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow": {
          "description": "Variables kept even though `deny` lists them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pct": {
          "description": "Percentage an instruction count may rise before `tak compare` fails. The gate for every series without its own `gate` table.",
          "type": "number",
          "minimum": 0
        },
        "min_delta": {
          "description": "Instructions a count may rise by before `tak compare` fails, whatever the percentage. A regression must exceed both. Default 0, no floor.",
          "type": "integer",
          "minimum": 0
        },
        "accept_trailers": {
          "description": "Honour `Tak-Accept:` commit trailers in `tak compare`. Off by default: the trailers are written by the change being gated.",
          "type": "boolean"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credit": {
          "description": "End generated reports with a line naming tak.",
          "type": "boolean"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "description": "Machine class to record under, overriding the derived name.",
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "cmd": {
      "description": "A command: a list of arguments, or a string split on whitespace. Never run through a shell. Values may be tera templates.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "gate": {
      "description": "This series' regression gate, overriding [gate] key by key. A subject's stacks on its benchmark's. Read by `tak compare` from the working tree's tak.toml; not recorded.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pct": {
          "description": "Percentage an instruction count may rise before `tak compare` fails.",
          "type": "number",
          "minimum": 0
        },
        "min_delta": {
          "description": "Instructions a count may rise by before `tak compare` fails, whatever the percentage. A regression must exceed both.",
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "description": "false reports a rise beyond the gate without failing on it.",
          "type": "boolean"
        }
      }
    },
    "layerProperties": {
      "runs": {
        "description": "Timed runs, or \"auto\" to size each subject from how long its samples take.",
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "const": "auto"
          }
        ]
      },
      "warmup": {
        "description": "Untimed runs before the timed ones.",
        "type": "integer",
        "minimum": 0
      },
      "budget": {
        "description": "runs = \"auto\": wall time per subject, prepare included, such as \"30s\", \"2m\" or \"500ms\".",
        "type": "string",
        "pattern": "^\\s*(0*[1-9][0-9]*(\\.[0-9]+)?|0*\\.[0-9]*[1-9][0-9]*)\\s*(ms|s|m|h)?\\s*$"
      },
      "min_runs": {
        "description": "runs = \"auto\": fewest runs a subject gets.",
        "type": "integer",
        "minimum": 1
      },
      "max_runs": {
        "description": "runs = \"auto\": most runs a subject gets.",
        "type": "integer",
        "minimum": 1
      },
      "ok_exit_codes": {
        "description": "Exit codes that count as a successful sample, timed or warmup, and under valgrind. Default [0]. Unix reports 0-255; Windows codes are 32-bit, with an NTSTATUS such as 0xC0000005 written as the negative -1073741819. A death by signal always fails, and setup and prepare must still exit 0.",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "minItems": 1
      },
      "prepare": {
        "description": "Untimed command run before every sample, warmups included.",
        "$ref": "#/definitions/cmd"
      },
      "check": {
        "description": "Untimed command run after every timed sample, not after warmups. Exit 0 means the sample passed; a failure is counted and reported, and does not drop the subject.",
        "$ref": "#/definitions/cmd"
      },
      "setup": {
        "description": "Untimed command run once per benchmark and subject, before any subject's first sample, from the directory holding tak.toml (not `dir`), so it can create `dir`.",
        "$ref": "#/definitions/cmd"
      },
      "version_cmd": {
        "description": "Command run once, untimed, before sampling, in the subject's directory and environment. The first non-empty line it prints (stdout, else stderr) is exported as the subject's version.",
        "$ref": "#/definitions/cmd"
      },
      "dir": {
        "description": "Directory to run in, relative to tak.toml. May be a tera template.",
        "type": "string"
      },
      "env": {
        "description": "Variables set for the command, merged key by key across layers. Values may be tera templates.",
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "vars": {
        "description": "Values for templates, as {{ vars.name }}. Not passed to the command.",
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "metric": {
        "description": "Custom metrics by name, recorded beside the timings and reported by `tak compare`, never gated. Merged by name across layers. Names use a-z, 0-9 and _, start with a letter, and cannot be `instructions` or start with `wall_`; end them with their unit, such as `binary_bytes`. Lower is taken as better.",
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "not": {
            "anyOf": [
              {
                "const": "instructions"
              },
              {
                "pattern": "^wall_"
              }
            ]
          }
        },
        "additionalProperties": {
          "$ref": "#/definitions/metric"
        }
      }
    },
    "metric": {
      "description": "One custom metric: exactly one of `file` or `cmd`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "A file whose size in bytes is the value, relative to tak.toml (not `dir`). Read once after the subject's samples. May be a tera template.",
          "type": "string",
          "minLength": 1
        },
        "cmd": {
          "description": "Run once, untimed, after the subject's samples, in its `dir` and `env`. Must exit 0 and print one non-negative number, such as 1234 or 12.5, and nothing else.",
          "$ref": "#/definitions/cmd"
        }
      },
      "oneOf": [
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "cmd"
          ]
        }
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "$ref": "#/definitions/layerProperties/runs"
        },
        "warmup": {
          "$ref": "#/definitions/layerProperties/warmup"
        },
        "budget": {
          "$ref": "#/definitions/layerProperties/budget"
        },
        "min_runs": {
          "$ref": "#/definitions/layerProperties/min_runs"
        },
        "max_runs": {
          "$ref": "#/definitions/layerProperties/max_runs"
        },
        "ok_exit_codes": {
          "$ref": "#/definitions/layerProperties/ok_exit_codes"
        },
        "prepare": {
          "$ref": "#/definitions/layerProperties/prepare"
        },
        "check": {
          "$ref": "#/definitions/layerProperties/check"
        },
        "setup": {
          "$ref": "#/definitions/layerProperties/setup"
        },
        "version_cmd": {
          "$ref": "#/definitions/layerProperties/version_cmd"
        },
        "dir": {
          "$ref": "#/definitions/layerProperties/dir"
        },
        "env": {
          "$ref": "#/definitions/layerProperties/env"
        },
        "vars": {
          "$ref": "#/definitions/layerProperties/vars"
        },
        "metric": {
          "$ref": "#/definitions/layerProperties/metric"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "$ref": "#/definitions/cmd"
        },
        "counters": {
          "description": "Count instructions for this subject. Off by default for named subjects.",
          "type": "boolean"
        },
        "runs": {
          "$ref": "#/definitions/layerProperties/runs"
        },
        "warmup": {
          "$ref": "#/definitions/layerProperties/warmup"
        },
        "budget": {
          "$ref": "#/definitions/layerProperties/budget"
        },
        "min_runs": {
          "$ref": "#/definitions/layerProperties/min_runs"
        },
        "max_runs": {
          "$ref": "#/definitions/layerProperties/max_runs"
        },
        "ok_exit_codes": {
          "$ref": "#/definitions/layerProperties/ok_exit_codes"
        },
        "prepare": {
          "$ref": "#/definitions/layerProperties/prepare"
        },
        "check": {
          "$ref": "#/definitions/layerProperties/check"
        },
        "setup": {
          "$ref": "#/definitions/layerProperties/setup"
        },
        "version_cmd": {
          "$ref": "#/definitions/layerProperties/version_cmd"
        },
        "dir": {
          "$ref": "#/definitions/layerProperties/dir"
        },
        "env": {
          "$ref": "#/definitions/layerProperties/env"
        },
        "vars": {
          "$ref": "#/definitions/layerProperties/vars"
        },
        "metric": {
          "$ref": "#/definitions/layerProperties/metric"
        },
        "when": {
          "description": "Measure only when this expr condition holds, e.g. '(env.VLT_BIN ?? \"\") != \"\"'. Sees env, os, arch, ci, bench and subject.",
          "type": "string"
        },
        "gate": {
          "$ref": "#/definitions/gate"
        }
      }
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "description": "The command, for a benchmark of one program. Not combined with subjects.",
          "$ref": "#/definitions/cmd"
        },
        "subjects": {
          "description": "Shared [subject.NAME] tables this benchmark measures.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "subject": {
          "description": "Subjects declared here, or overrides of shared ones for this benchmark.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/subject"
          }
        },
        "runs": {
          "$ref": "#/definitions/layerProperties/runs"
        },
        "warmup": {
          "$ref": "#/definitions/layerProperties/warmup"
        },
        "budget": {
          "$ref": "#/definitions/layerProperties/budget"
        },
        "min_runs": {
          "$ref": "#/definitions/layerProperties/min_runs"
        },
        "max_runs": {
          "$ref": "#/definitions/layerProperties/max_runs"
        },
        "ok_exit_codes": {
          "$ref": "#/definitions/layerProperties/ok_exit_codes"
        },
        "prepare": {
          "$ref": "#/definitions/layerProperties/prepare"
        },
        "check": {
          "$ref": "#/definitions/layerProperties/check"
        },
        "setup": {
          "$ref": "#/definitions/layerProperties/setup"
        },
        "version_cmd": {
          "$ref": "#/definitions/layerProperties/version_cmd"
        },
        "dir": {
          "$ref": "#/definitions/layerProperties/dir"
        },
        "env": {
          "$ref": "#/definitions/layerProperties/env"
        },
        "vars": {
          "$ref": "#/definitions/layerProperties/vars"
        },
        "metric": {
          "$ref": "#/definitions/layerProperties/metric"
        },
        "when": {
          "description": "Run this benchmark only when this expr condition holds. Sees env, os, arch, ci and bench.",
          "type": "string"
        },
        "gate": {
          "$ref": "#/definitions/gate"
        }
      },
      "anyOf": [
        {
          "required": [
            "cmd"
          ]
        },
        {
          "required": [
            "subjects"
          ],
          "properties": {
            "subjects": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "subject": {
              "minProperties": 1
            }
          }
        }
      ],
      "not": {
        "allOf": [
          {
            "required": [
              "cmd"
            ]
          },
          {
            "anyOf": [
              {
                "required": [
                  "subjects"
                ],
                "properties": {
                  "subjects": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "subject"
                ],
                "properties": {
                  "subject": {
                    "minProperties": 1
                  }
                }
              }
            ]
          }
        ]
      },
      "description": "A benchmark: either one `cmd`, or `subjects` and/or `subject` tables, not both."
    }
  }
}
