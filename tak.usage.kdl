name tak
bin tak
about "CLI performance, tracked"
unknown_flags error
subcommand_required #true
flag --env-deny help="Remove a variable from the environment of measured commands. Repeatable. Replaces the default list rather than adding to it." global=#true var=#true {
    arg <VAR>
}
flag --env-allow help="Keep a variable that --env-deny would remove. Repeatable." global=#true var=#true {
    arg <VAR>
}
flag --gate-pct help="Percentage an instruction count may rise before `compare` fails." global=#true {
    arg <PCT>
}
flag no-credit: help="Leave the line naming tak off the end of generated reports." global=#true negate=--no-credit default="true"
flag --runner help="Machine class to record under. Overrides the derived name." global=#true {
    arg <CLASS>
}
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd run help="Benchmark a command, or everything declared in tak.toml." {
    flag --bench help="Name to record this measurement under. With no command, selects a single benchmark from tak.toml instead of running all of them." {
        arg <BENCH>
    }
    flag --runs help="Timed runs. Overrides tak.toml when both are given." {
        arg <RUNS>
    }
    flag --warmup help="Untimed warmup runs. Overrides tak.toml when both are given." {
        arg <WARMUP>
    }
    flag --no-counters help="Skip instruction counting even where valgrind is available."
    flag --record help="Append the result to refs/notes/tak for the current commit."
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[CMD]..." help="Command to benchmark, after `--`. Omit to run what tak.toml declares." double_dash=required
}
cmd history help="Show recorded history for a commit." {
    flag --remote help="Remote to refresh notes from." default=origin {
        arg <REMOTE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[REV]" help="Revision to read. Defaults to HEAD." default=HEAD
}
cmd push help="Push recorded measurements to the remote." {
    flag --remote help="Remote to use for git-notes synchronization." default=origin {
        arg <REMOTE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd init help="Teach plain `git fetch` about the notes ref." {
    flag --remote help="Remote to use for git-notes synchronization." default=origin {
        arg <REMOTE>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd backfill help="Benchmark published release binaries to bootstrap history." {
    long_help #"""
Benchmark published release binaries to bootstrap history.

A new adopter's first chart is empty. Rather than rebuilding a project at a hundred historical commits, download what it already published.
"""#
    flag --repo help="Repository to pull releases from, as \"owner/name\". Defaults to the `origin` remote of the current repository." {
        arg <REPO>
    }
    flag --bin help="Executable name to look for inside each release archive. Defaults to the repository name." {
        arg <BIN>
    }
    flag --bench help="Name to record measurements under." default=release {
        arg <BENCH>
    }
    flag --limit help="Most recent releases to measure." default="20" {
        arg <LIMIT>
    }
    flag --runs help="Timed runs per release." default="10" {
        arg <RUNS>
    }
    flag --dry-run help="Measure but do not write to refs/notes/tak."
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Arguments passed to the downloaded binary, after `--`. Defaults to `--version`, which every CLI answers cheaply." double_dash=required
}
cmd compare help="Compare this commit's measurements against another's." {
    long_help #"""
Compare this commit's measurements against another's.

Fails when an instruction count has risen by more than `gate_pct`. Wall clock is reported and never gated.
"""#
    flag --rev help="Revision to compare. Defaults to HEAD." default=HEAD {
        arg <REV>
    }
    flag --remote help="Remote to refresh notes from." default=origin {
        arg <REMOTE>
    }
    flag --no-gate help="Report without failing, whatever the numbers say."
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[BASE]" help="Revision to compare against." default="origin/main"
}
cmd doctor help="Diagnose the git-notes plumbing." {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd settings help="Show every setting, its resolved value, and where that value came from." {
    flag --docs help="Include the full description of each setting."
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd usage help="Generate the CLI specification used to build the documentation." hide=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
}
config {
    prop "env_deny" type="list<string>" parse="list_by_comma" since="0.0.3" help="Environment variables removed from every command tak measures." long_help="Environment variables removed from every command tak measures.\n\nTwo reasons this defaults to a non-empty list rather than to nothing.\n\n**Determinism.** A CLI that finds a forge token in its environment often does more with it than without — authenticating, fetching, checking rate limits. A measurement that moves depending on whether CI happened to export a token is not a measurement of the code under test. It lands in the series as an unexplained step change on the day someone edits an unrelated workflow.\n\n**This is not a credential sandbox.** The listed variables are absent from the child's direct environment, but a hostile binary can still inspect accessible same-user processes and files. In particular, `tak backfill` downloads and executes release binaries; run it on an isolated credential-free machine when those assets are not fully trusted.\n\nSetting this replaces the default list rather than adding to it. To keep the defaults and remove more, list them alongside. To keep the defaults and remove fewer, use `env_allow` — it is subtracted from this list, so the two compose without either having to restate the other.\n\nNames are matched exactly. There is no globbing: a benchmark whose behaviour depends on which variables happen to match a pattern is the problem this setting exists to avoid.\n\ntak's own network calls are unaffected. `backfill` authenticates with `curl` directly rather than through the measurement path." {
        default "GITHUB_TOKEN" "GH_TOKEN"
        env "TAK_ENV_DENY"
        cli "--env-deny"
        example "tak run --env-deny AWS_PROFILE --env-deny AWS_REGION"
        example "TAK_ENV_DENY=GITHUB_TOKEN,GH_TOKEN,NPM_TOKEN tak run"
        source "config" "env.deny"
    }
    prop "env_allow" type="list<string>" parse="list_by_comma" since="0.0.3" help="Environment variables kept even though `env_deny` lists them." long_help="Environment variables kept even though `env_deny` lists them.\n\nSubtracted from `env_deny`, so a project can opt one variable back in without restating the whole default list. A CLI whose measured path genuinely requires a token — a client that cannot start unauthenticated, say — needs this.\n\nDoing so makes the measurement depend on something outside the repository. That is a real cost, not a formality: the numbers become conditional on the environment the run happened to have, and a token expiring will read as a performance change.\n\nListing a variable here that `env_deny` does not mention has no effect. This setting removes entries from the deny list; it does not add anything to the environment." {
        default 
        env "TAK_ENV_ALLOW"
        cli "--env-allow"
        example "tak run --env-deny GITHUB_TOKEN --env-allow GITHUB_TOKEN"
        source "config" "env.allow"
    }
    prop "gate_pct" type="float" default=1.0 since="0.0.4" help="How much an instruction count may rise before `tak compare` fails." long_help="How much an instruction count may rise before `tak compare` fails.\n\nA percentage of the base measurement. Only instruction counts are gated. Wall clock is reported and never gated: on the same hardware it moves 4-20% run to run, so a threshold tight enough to catch a real regression would fire constantly, and one loose enough to stay quiet would catch nothing.\n\nThe default of 1% is about fifty times the ~0.02% instruction counting reproduces to, leaving room for the small differences a compiler or dependency bump can produce without turning the gate into noise.\n\nRaise it to report without effectively failing. Setting it to zero fails on any increase at all, which sounds appealing and is not: one extra instruction on a startup path is not worth blocking a pull request over." {
        env "TAK_GATE_PCT"
        cli "--gate-pct"
        example "tak compare origin/main --gate-pct 0.5"
        example "TAK_GATE_PCT=5 tak compare origin/main"
        source "config" "gate.pct"
    }
    prop "credit" type="bool" default=#true since="0.0.4" help="Whether generated reports end with a line naming tak." long_help="Whether generated reports end with a line naming tak.\n\nOn by default. A report that appears in someone's pull request should say what put it there — a reader who has never heard of tak needs a way to find out, and a maintainer evaluating the comment needs to know what to turn off.\n\nTurn it off with `--no-credit`, `TAK_CREDIT=0`, or `credit = false` under `[report]`. Nothing else about the report changes." {
        env "TAK_CREDIT"
        cli "--no-credit"
        example "tak compare origin/main --no-credit"
        example "TAK_CREDIT=0 tak compare origin/main"
        source "config" "report.credit"
    }
    prop "runner_class" type="string" default="" default_note="derived from the machine" since="0.0.6" help="The machine class a measurement is recorded under, and compared within." long_help="The machine class a measurement is recorded under, and compared within.\n\nEmpty means derive it: `gha-<os>-<arch>` under GitHub Actions, `local-<os>-<arch>` otherwise. That is right until something about the machine changes without the name changing.\n\nSeries are partitioned on this, and must be. Absolute instruction counts shift between machine types by more than a real regression does, so tak will not compare across classes — it reports the old series as removed and the new one as added rather than inventing a step change.\n\nSet it when the *environment* changes in a way the derived name cannot see. The common case is a toolchain bump: a hosted runner image or a compiler upgrade between the base measurement and this one is attributed to the code otherwise, and on a one-percent gate that is a false failure. Encoding the compiler version into the class starts a fresh series at the bump, which is honest — the numbers either side genuinely are not comparable.\n\ntak cannot detect this for you. It measures programs, not build systems, and has no way to know what produced the binary it is timing." {
        env "TAK_RUNNER"
        cli "--runner"
        example "TAK_RUNNER=gha-linux-x64-rust1.85 tak run --record"
        example "tak run --runner gha-linux-x64-glibc2.39"
        source "config" "runner.class"
    }
}
